---
const {media, lang = 'es', class: className, eager = false} = Astro.props;
---
{media && (media.type?.startsWith('video/') ?
  <video class={className} style={`object-fit:${media.fit || 'cover'};object-position:${media.position || '50% 50%'}`} controls playsinline preload="metadata" aria-label={media.alt[lang]}><source src={media.src} type={media.type}/><a href={media.src}>{media.alt[lang]}</a></video> :
  <img class={className} style={`object-fit:${media.fit || 'cover'};object-position:${media.position || '50% 50%'}`} src={media.src} alt={media.alt[lang]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined}/>)}
