---
import Layout from '../layouts/Layout.astro';
import Localized from './Localized.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import {home, type Language} from '../i18n';
import es from '../content/privacy/es.html?raw';
import en from '../content/privacy/en.html?raw';
import fr from '../content/privacy/fr.html?raw';

const {lang = 'es'} = Astro.props as {lang?: Language};
const copy = {
 es: {title: "Aviso Legal y Política de Privacidad", back: "Volver al estudio", content: es},
 en: {title: "Legal Notice & Privacy Policy", back: "Back to the studio", content: en},
 fr: {title: "Mentions legales et politique de confidentialite", back: "Retour au studio", content: fr},
}[lang];
---
<Layout lang={lang} legal={true} pageTitle={copy.title}>
 <Localized lang={lang}><Header lang={lang} legal={true}/></Localized>
 <main class="legal-page section-pad">
  <a class="eyebrow" href={home(lang)}>{copy.back}</a>
  <Fragment set:html={copy.content} />
 </main>
 <Localized lang={lang}><Footer lang={lang}/></Localized>
</Layout>

<style>
 .legal-page :global(h3) {font-size:1.125rem;font-weight:500;line-height:1.5;margin:1.75rem 0 .75rem}
 .legal-page :global(ul) {max-width:800px;padding-left:1.5rem;color:#b8bcb6;line-height:1.8}
 .legal-page :global(li + li) {margin-top:.375rem}
</style>
