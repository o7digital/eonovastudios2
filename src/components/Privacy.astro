---
import Layout from '../layouts/Layout.astro';
import Localized from './Localized.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import {home} from '../i18n';
const {lang = 'es'} = Astro.props;
const copy = {
 es: {title:'Aviso de privacidad', intro:'Información legal y política de privacidad de o7 Digital Consulting.', company:'Responsable', address:'Domicilio social', hosting:'Alojamiento de la página de o7', data:'Datos personales', text:'Los datos enviados mediante los formularios se utilizan únicamente para responder a las solicitudes dirigidas a O7 Digital Consulting. Puedes solicitar el acceso, la rectificación o la eliminación de tus datos por correo electrónico.', source:'Contenido de referencia', detail:'Este aviso reproduce en español la información publicada por o7 Digital Consulting. La página de referencia identifica a GitHub como su proveedor de alojamiento; este sitio EON NOVA está alojado en Vercel.', chat:'Conversaciones con Olivia IA', chatText:'Si utilizas Olivia y aceptas el tratamiento de tus mensajes, estos se transmiten al servicio Olivia IA de o7Digital y a su proveedor de inteligencia artificial para responder a tu consulta. El servicio guarda el intercambio y su contexto. No compartas datos sensibles, información confidencial ni datos de terceros. Desmarcar el consentimiento impide enviar nuevos mensajes, pero no elimina los ya enviados.', back:'Volver al estudio'},
 en: {title:'Privacy notice',intro:'Legal information and privacy policy of o7 Digital Consulting.',company:'Data controller',address:'Registered office',hosting:'Hosting of the o7 website',data:'Personal data',text:'Data submitted through forms is used solely to respond to requests sent to O7 Digital Consulting. You may request access to, correction or deletion of your data by email.',source:'Reference content',detail:'This notice translates the information published by o7 Digital Consulting into English. The reference page identifies GitHub as its hosting provider; this EON NOVA website is hosted on Vercel.',chat:'Conversations with Olivia AI',chatText:'When you use Olivia and consent to the processing of your messages, they are sent to the o7Digital Olivia AI service and its AI provider to answer your enquiry. The service stores the conversation and its context. Do not share sensitive data, confidential information or other people’s data. Withdrawing consent prevents new messages from being sent but does not delete messages already submitted.',back:'Back to the studio'},
 fr: {title:'Mentions légales et confidentialité',intro:'Informations légales et politique de confidentialité d’o7 Digital Consulting.',company:'Responsable du traitement',address:'Siège social',hosting:'Hébergement du site o7',data:'Données personnelles',text:'Les données transmises via les formulaires sont utilisées uniquement pour répondre aux demandes envoyées à O7 Digital Consulting. Vous pouvez demander l’accès, la rectification ou la suppression de vos données par e-mail.',source:'Contenu de référence',detail:'Cette page reprend les informations publiées par o7 Digital Consulting. La page de référence indique GitHub comme hébergeur ; ce site EON NOVA est hébergé sur Vercel.',chat:'Conversations avec Olivia IA',chatText:'Lorsque vous utilisez Olivia et acceptez le traitement de vos messages, ceux-ci sont transmis au service Olivia IA d’o7Digital et à son fournisseur d’intelligence artificielle pour répondre à votre demande. Le service conserve l’échange et son contexte. Ne partagez pas de données sensibles, d’informations confidentielles ou de données de tiers. Retirer votre consentement empêche l’envoi de nouveaux messages, mais ne supprime pas les messages déjà envoyés.',back:'Retour au studio'}
}[lang as 'es'|'en'|'fr'];
---
<Layout lang={lang} legal={true} pageTitle={copy.title}><Localized lang={lang}><Header lang={lang} legal={true}/></Localized><main class="legal-page section-pad"><a class="eyebrow" href={home(lang)}>← {copy.back}</a><h1>{copy.title}</h1><p class="legal-intro">{copy.intro}</p><section><h2>{copy.company}</h2><p>O7 Digital Consulting SASU<br/>SIREN: 899 748 560 · SIRET: 899 748 560 00013</p><p>{copy.address}: 10 rue de Penthièvre, 75008 Paris, France</p><a href="mailto:info@o7digitalgroup.com">info@o7digitalgroup.com</a></section><section><h2>{copy.hosting}</h2><p>GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, USA.</p></section><section><h2>{copy.data}</h2><p>{copy.text}</p></section><section><h2>{copy.chat}</h2><p>{copy.chatText}</p></section><section><h2>{copy.source}</h2><p>{copy.detail}</p><a href="https://www.o7digital.com/privacy-policy" target="_blank" rel="noopener noreferrer">o7 Digital Consulting — Privacy policy ↗</a></section></main><Localized lang={lang}><Footer lang={lang}/></Localized></Layout>
