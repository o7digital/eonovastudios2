---
import {translate} from '../i18n';
import dictionary from '../i18n/translations.json';
import {applyCopy, getCms} from '../lib/cms.mjs';
const {lang = 'es'} = Astro.props;
const {rows} = await getCms();
const translated = translate(await Astro.slots.render('default'), lang);
const html = rows.length ? applyCopy(translated, rows, lang, dictionary) : translated;
---
<Fragment set:html={html} />
