---
import Brand from './Brand.astro';
import {home, privacy, languages} from '../i18n';
const {lang = 'es', legal = false} = Astro.props;
const base = home(lang);
---
<header class="nav"><Brand lang={lang}/><nav aria-label="Principal"><a href={base + '#universos'}>Universos</a><a href={base + '#servicios'}>Servicios</a><a href={base + '#studio'}>El estudio</a><a href={base + '#contacto'}>Contacto</a></nav><div class="languages" aria-label="Language">{languages.map(l => <a href={legal ? privacy(l) : home(l)} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}</div></header>
